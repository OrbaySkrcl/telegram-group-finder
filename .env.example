# --- Telegram (https://my.telegram.org -> API development tools) ---
TG_API_ID=1234567
TG_API_HASH=abcdef0123456789abcdef0123456789
# "python login.py" ciktisini buraya yapistir
TG_SESSION=

# --- Depolama ---
# Railway'de volume mount path'i /data yap
DB_PATH=./data/tgfinder.db

# --- Simulasyon parametreleri (durust getiri hesabi icin) ---
SIM_ENTRY_DELAY_SEC=60     # mesaji gorup alana kadar gecen sure
SIM_SLIPPAGE=0.03          # her islemde %3 slipaj+ucret
SIM_TP_MULTIPLE=2.0        # 2x'te sat
SIM_SL_DROP=0.5            # -%50'de kes
SIM_HORIZON_HOURS=24       # takip suresi

# --- Skorlama ---
SCORE_WINDOW_DAYS=30
SCORE_MIN_CALLS=5

# --- Kontrol arayuzu ---
# ONERILEN: @BotFather'dan bir bot olustur, token'i buraya yapistir.
# Boylece sistemin Telegram'da kendi sohbet penceresi olur ve Kayitli
# Mesajlar'ina karismaz. Botu acip Start'a basmayi unutma.
TG_BOT_TOKEN=

# Bot kullanmazsan komutlar bu sohbette dinlenir ("me" = Kayitli Mesajlar).
# Baska bir sohbet de verebilirsin, ornegin kendi ozel kanalinin kullanici adi.
REPORT_CHAT=me

# Bot sohbetinde komutlari sadece bu kullanici verebilir. Bos birakirsan
# TG_SESSION'in ait oldugu hesap otomatik sahip kabul edilir.
TG_OWNER_ID=

REPORT_HOUR_UTC=6

# --- Guvenlik limitleri ---
MAX_JOINS_PER_DAY=8
